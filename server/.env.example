# Server locale: "en" or "fr". Unset or invalid → English.
DEFAULT_LANGUAGE="en"

# PostgreSQL connection string
DATABASE_URL="postgres://user:password@localhost:5432/firebird-money"

# "production" or "development". Only "production" is treated as production.
APP_ENV="development"

# Skips the magic-link email: sign-in logs you straight in. Handy on localhost, refused at
# startup when APP_ENV is "production". "true" or "false". Unset or invalid → "false".
SKIP_EMAIL_VERIFICATION="true"

# Resend API key, used to send magic-link emails. Required unless SKIP_EMAIL_VERIFICATION is true.
RESEND_API_KEY=""

# Sender of the magic-link emails. "onboarding@resend.dev" works without a verified domain.
EMAIL_FROM="FireBird Money <onboarding@resend.dev>"

# Where the magic link points, i.e. the client origin.
CLIENT_BASE_URL="http://localhost:5173"
