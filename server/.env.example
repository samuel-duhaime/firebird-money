# "en" | "fr". Unset or invalid → "en".
DEFAULT_LANGUAGE="en"

# PostgreSQL connection string.
DATABASE_URL="postgres://user:password@localhost:5432/firebird-money"

# "production" | "development". Required — anything else refuses to start.
APP_ENV="development"

# "true" | "false". Unset or invalid → "false".
# "true" skips the magic-link email and signs you in right away. Refused when APP_ENV="production".
SKIP_EMAIL_VERIFICATION="true"

# Resend API key. Required unless SKIP_EMAIL_VERIFICATION="true".
RESEND_API_KEY=""

# Sender of the magic-link emails. "onboarding@resend.dev" needs no verified domain but only
# delivers to the email address on your Resend account; other recipients need a verified domain.
EMAIL_FROM="FireBird Money <onboarding@resend.dev>"

# Client origin the magic link points at.
CLIENT_BASE_URL="http://localhost:5173"
