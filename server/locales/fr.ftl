# Chaînes visibles de l’API

transaction-not-found = Aucune transaction avec l’id { $n }
transaction-merchant-required = merchant_id ou original_statement est requis
category-not-found = Aucune catégorie avec l’id { $n }
category-duplicate-name = Une catégorie avec ce nom existe déjà
category-in-use = La catégorie { $n } est toujours utilisée par des transactions existantes
category-group-not-found = Aucun groupe de catégories avec l’id { $n }
category-group-duplicate-name = Un groupe de catégories avec ce nom existe déjà
category-group-invalid-type = type doit être income, expense ou transfer
category-group-in-use = Le groupe de catégories { $n } est toujours utilisé par des catégories existantes
household-not-found = Aucun ménage avec l’id { $n }
household-has-members = Seule la dernière personne d’un ménage peut le supprimer. Quitte-le plutôt
household-leave-alone = Tu es la seule personne dans ce ménage. Supprime-le plutôt
user-not-found = Aucun utilisateur avec l’id { $n }
user-duplicate-email = Un utilisateur avec ce courriel existe déjà
user-invalid-status = status doit être verified, pending ou suspended
user-in-use = L’utilisateur { $n } est toujours connecté à un ménage
member-not-found = Aucun membre de ménage avec l’id { $n }
member-invalid-role = role doit être family_manager ou family_member
member-requires-manager = Seul un gestionnaire familial peut modifier ou retirer des membres
member-last-manager = Le ménage a besoin d’un gestionnaire familial. Nomme quelqu’un d’autre avant
member-remove-self = Pour te retirer du ménage, quitte-le plutôt
member-picture-not-found = Aucune photo pour le membre du ménage avec l’id { $n }
member-picture-forbidden = Seuls ce membre ou un gestionnaire familial peuvent changer sa photo
member-picture-invalid = La photo doit être une image PNG, JPEG ou WebP
member-picture-too-large = La photo est trop volumineuse (2 Mo maximum)
tag-not-found = Aucune étiquette avec l’id { $n }
tag-duplicate-name = Une étiquette avec ce nom existe déjà
tag-in-use = L’étiquette { $n } est toujours utilisée par des transactions existantes
rule-not-found = Aucune règle avec l’id { $n }
rule-no-condition = Une règle a besoin d’au moins une condition
rule-no-action = Une règle a besoin d’au moins une action
rule-invalid-condition = Une des conditions de la règle est incomplète
rule-unknown-reference = Un des marchands, catégories, comptes, étiquettes ou membres de la règle n’existe pas
merchant-not-found = Aucun marchand avec l’id { $n }
merchant-duplicate-name = Un marchand avec ce nom existe déjà
merchant-in-use = Le marchand { $n } est toujours utilisé par des transactions existantes
merchant-name-required = Un nom est requis
institution-not-found = Aucune institution avec l’id { $n }
institution-duplicate-name = Une institution avec ce nom existe déjà
institution-in-use = L’institution { $n } a encore des comptes
institution-name-required = Un nom est requis
institution-invalid-website = website_url doit commencer par http:// ou https://
account-not-found = Aucun compte avec l’id { $n }
account-in-use = Le compte { $n } est toujours utilisé par des transactions existantes
account-name-required = Un nom est requis
account-invalid-type = type doit être checking, savings, credit_card, investment, loan, mortgage, cash ou other
account-invalid-last-four = last_four doit contenir de 1 à 4 lettres ou chiffres
account-invalid-currency = currency doit être un code de 3 lettres, p. ex. CAD
account-owner-required = owner est requis : "shared" ou l’id d’un membre
account-owner-not-found = Le propriétaire doit être un membre de ce ménage
review-assignee-not-found = La personne qui révise doit être membre de ce ménage
account-owners-duplicate = Chaque compte ne peut être indiqué qu’une fois
account-owners-account-not-found = Un des comptes n’existe pas
# Courriel de connexion. Le lien est inséré entre les instructions et la signature.
auth-email-subject = Ton lien de connexion FireBird Money
auth-email-greeting = Bonjour,
auth-email-instructions = Clique sur le lien ci-dessous pour te connecter à FireBird Money. Il expire dans 15 minutes et ne sert qu’une fois.
auth-email-ignore = Si tu n’as pas demandé à te connecter, tu peux ignorer ce courriel.

auth-email-invalid = Une adresse courriel valide est requise
auth-token-invalid = Ce lien de connexion est invalide, expiré ou déjà utilisé
auth-email-send-failed = Le courriel de connexion n’a pas pu être envoyé, veuillez réessayer
auth-host-refused = La connexion sans courriel fonctionne seulement sur cet ordinateur
auth-not-signed-in = Vous devez être connecté
auth-no-household = Vous devez appartenir à un ménage
auth-join-code-not-found = Aucun ménage ne correspond à ce code d’invitation
auth-join-code-blank = join_code ne peut pas être vide; omets-le pour créer un nouveau ménage à la place
auth-already-in-household = Vous êtes déjà connecté à un ménage
auth-name-required = Un prénom est requis
import-file-required = Un fichier à importer est requis
import-file-too-large = Le fichier téléversé est trop volumineux (10 Mo maximum)
import-file-unsupported = Seuls les fichiers PDF, images (PNG, JPG, GIF, WebP), CSV et Excel peuvent être importés
import-file-unreadable = Aucune transaction n’a pu être lue dans ce fichier
import-file-too-long = Ce relevé est trop long pour être lu d’un coup, essaie une période plus courte
import-unavailable = L’importation de relevés n’est pas configurée sur ce serveur
import-read-failed = Le relevé n’a pas pu être lu pour l’instant, réessaie
import-empty = Choisis au moins une transaction à importer
import-too-many = Importe au plus { $n } transactions à la fois
import-merchant-required = Chaque transaction a besoin d’un marchand existant ou d’un nom de nouveau marchand
import-account-required = Chaque transaction a besoin d’un compte existant ou d’un nouveau compte valide
import-merchant-not-found = Un des marchands n’existe pas
import-account-not-found = Un des comptes n’existe pas
import-category-not-found = Une des catégories n’existe pas
internal-db-error = Erreur interne du serveur
