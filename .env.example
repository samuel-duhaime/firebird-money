# Settings for `docker compose`. Copy to `.env` next to docker-compose.yml.
# Local development without Docker uses server/.env and client/.env instead.

# Database password. Required. Letters and digits only, since it goes inside a connection URL.
# Postgres only reads it when the database is first created: changing it here later locks the app
# out until it's also changed inside Postgres.
POSTGRES_PASSWORD=""

# Port the app opens on: http://localhost:8055
APP_PORT="8055"

# "en" | "fr". Unset or invalid → "en".
DEFAULT_LANGUAGE="en"

# Claude API key for statement import. Optional: unset turns statement import off.
ANTHROPIC_API_KEY=""
